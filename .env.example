# Database — Railway provides this automatically when you attach a Postgres service
DATABASE_URL=postgres://user:password@host:5432/dbname

# Payload — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public server URL — your domain in production, http://localhost:3000 locally
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Root domain for subdomain routing (no protocol, no trailing slash)
ROOT_DOMAIN=xmphdalf.dev

# Seed script — creates the initial super-admin (only needed once)
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_SLUG=
